# ============================================================================
# Synapse Web Frontend — Environment Configuration (.env.example)
# ============================================================================

# Optional override for deployed environments (defaults to /api/knowledge and /api via Vite proxy)
# VITE_KNOWLEDGE_API_URL=http://localhost:8000/api/knowledge
# VITE_GUARD_API_URL=http://localhost:4000/api

# Local Vite dev-server proxy targets
KNOWLEDGE_DEV_PROXY=http://localhost:8000
GUARD_DEV_PROXY=http://localhost:4000

# Optional for legacy Vercel /api/assist serverless function fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
