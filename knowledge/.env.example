# ============================================================================
# Synapse Knowledge Service — Environment Configuration (.env.example)
# Copy this file to knowledge/.env and fill in the required values.
# Never commit real API keys or secrets.
# ============================================================================

# --- Database & Storage ---
# Default for local development is persistent SQLite in knowledge/data/knowledge.db.
# For production PostgreSQL with pgvector:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/synapse_knowledge
DATABASE_URL=sqlite:///./data/knowledge.db
KNOWLEDGE_STORAGE_PATH=./data/uploads

# --- Authentication & Synapse Guard Integration ---
# Must match the JWT_SECRET used by Synapse Guard (guard/src/config.js).
JWT_SECRET=dev-only-secret-change-me
GUARD_API_URL=http://localhost:4000
# "closed" rejects queries if Guard is unreachable; "open" continues without remote Guard check.
GUARD_FAIL_MODE=closed
KNOWLEDGE_ADMIN_ROLES=admin
KNOWLEDGE_CHAT_ROLES=student,admin

# --- Embedding Provider ---
# Supported: gemini | openai | local
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=
# You can also set GEMINI_API_KEY or OPENAI_API_KEY directly.
GEMINI_API_KEY=

# --- Answer Generation (RAG LLM) ---
# Supported: gemini | anthropic | none (extractive fallback only)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=
LLM_TIMEOUT_S=30

# --- Chunking & Retrieval ---
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=6
RETRIEVAL_TOP_K_MAX=10
RETRIEVAL_MIN_SCORE=0.62
RETRIEVAL_STRONG_SCORE=0.72

# --- Limits & CORS ---
MAX_UPLOAD_MB=20
RATE_LIMIT_QUERY_PER_MIN=20
RATE_LIMIT_ADMIN_PER_MIN=60
KNOWLEDGE_CORS_ORIGINS=http://localhost:5173
